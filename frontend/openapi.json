{
  "openapi": "3.1.0",
  "info": {
    "title": "WindDesk API",
    "description": "Day-ahead wind forecast intelligence for GB electricity trading.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "Meta",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/delivery-day": {
      "get": {
        "summary": "Delivery Day",
        "operationId": "delivery_day_api_delivery_day_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Delivery day (YYYY-MM-DD)",
              "title": "Date"
            },
            "description": "Delivery day (YYYY-MM-DD)"
          },
          {
            "name": "auction",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "epex_60",
                "n2ex_60",
                "epex_30"
              ],
              "type": "string",
              "description": "Auction whose gate closure is the decision cutoff",
              "default": "epex_60",
              "title": "Auction"
            },
            "description": "Auction whose gate closure is the decision cutoff"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryDayResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/accuracy": {
      "get": {
        "summary": "Accuracy",
        "operationId": "accuracy_api_accuracy_get",
        "parameters": [
          {
            "name": "auction",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "epex_60",
                "n2ex_60",
                "epex_30"
              ],
              "type": "string",
              "description": "Auction whose gate closure is the decision cutoff",
              "default": "epex_60",
              "title": "Auction"
            },
            "description": "Auction whose gate closure is the decision cutoff"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/lead-time": {
      "get": {
        "summary": "Lead Time",
        "operationId": "lead_time_api_lead_time_get",
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 48,
              "minimum": 0,
              "description": "Minimum lead time",
              "default": 4,
              "title": "Hours"
            },
            "description": "Minimum lead time"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First delivery day",
              "title": "Start"
            },
            "description": "First delivery day"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last delivery day",
              "title": "End"
            },
            "description": "Last delivery day"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadTimeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
